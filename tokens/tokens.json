{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Salla Design System tokens. Three tiers, following Material Design's reference -> system -> component token model. Values marked verified were read from the Merchant - Storybook DS Figma library (branch dnmyqzYKK9dUJjVHuIWMDS) on 2026-09-22. Values marked assumed follow the Tailwind scale that the Figma style names ($text-lg, spacing/2xl ...) mirror and must be confirmed in Figma before release.",

  "ref": {
    "$description": "Reference (primitive) tokens. Raw values with no meaning attached. Material calls these 'reference tokens'. Consumers never use these directly.",
    "palette": {
      "teal": {
        "900": { "$type": "color", "$value": "#004956", "$description": "Salla primary. verified (text/primary/primary, background/primary/primary)" },
        "100": { "$type": "color", "$value": "#a4ffe5", "$description": "Salla secondary mint. verified (background/secondary, border/secondary)" }
      },
      "gray": {
        "0":   { "$type": "color", "$value": "#ffffff", "$description": "verified (text/gray/white, background/default/white)" },
        "100": { "$type": "color", "$value": "#eeeeee", "$description": "verified (border/default)" },
        "600": { "$type": "color", "$value": "#666666", "$description": "verified (text/gray/light)" },
        "800": { "$type": "color", "$value": "#333333", "$description": "verified (text/gray/dark)" }
      },
      "green": {
        "500": { "$type": "color", "$value": "#00af6c", "$description": "verified (background/status/success/primary)" },
        "600": { "$type": "color", "$value": "#008c56", "$description": "verified (success/success-dark)" },
        "800": { "$type": "color", "$value": "#005232", "$description": "verified (success/success-darker)" }
      },
      "red": {
        "50":  { "$type": "color", "$value": "#feecec", "$description": "verified (danger/danger-lighter)" },
        "500": { "$type": "color", "$value": "#f55157", "$description": "verified (background/status/danger/primary)" },
        "600": { "$type": "color", "$value": "#ca4146", "$description": "verified (danger/danger-dark)" },
        "800": { "$type": "color", "$value": "#7a1f1e", "$description": "verified (danger/danger-darker)" }
      },
      "amber": {
        "500": { "$type": "color", "$value": "#ffaf44", "$description": "verified (background/status/warning/primary)" }
      },
      "blue": {
        "50":  { "$type": "color", "$value": "#ecf3fe", "$description": "verified (background/status/info/lighter)" },
        "100": { "$type": "color", "$value": "#cbe0fb", "$description": "verified (border/status/info-light)" },
        "500": { "$type": "color", "$value": "#5196f3", "$description": "verified (background/status/info/primary)" },
        "800": { "$type": "color", "$value": "#204374", "$description": "verified (text/status/info/darker)" }
      },
      "orange": {
        "200": { "$type": "color", "$value": "#ffd8c2", "$description": "verified (color/support-non-semantic/orange/200)" },
        "300": { "$type": "color", "$value": "#ffaf83", "$description": "verified (color/support-non-semantic/orange/300)" },
        "800": { "$type": "color", "$value": "#883000", "$description": "verified (background/supporting-colors/orange/darker)" }
      }
    },
    "space": {
      "$description": "4px grid (Material uses a 4dp grid). Figma today has two clashing scales: spacing/* (6xs=2 ... 2xl=24) and Spacing/Sizes/* (3xs=2, sm=8, lg=12). This is the single reference scale both must map to.",
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "2px" },
      "2":  { "$type": "dimension", "$value": "4px" },
      "3":  { "$type": "dimension", "$value": "8px" },
      "4":  { "$type": "dimension", "$value": "12px" },
      "5":  { "$type": "dimension", "$value": "16px" },
      "6":  { "$type": "dimension", "$value": "20px" },
      "7":  { "$type": "dimension", "$value": "24px" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "9":  { "$type": "dimension", "$value": "40px" },
      "10": { "$type": "dimension", "$value": "48px" },
      "11": { "$type": "dimension", "$value": "64px" },
      "12": { "$type": "dimension", "$value": "80px" }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px",    "$description": "Radius/Sizes/None" },
      "sm":   { "$type": "dimension", "$value": "2px",    "$description": "assumed" },
      "md":   { "$type": "dimension", "$value": "4px",    "$description": "verified (radius/md on checkbox)" },
      "lg":   { "$type": "dimension", "$value": "6px",    "$description": "assumed" },
      "xl":   { "$type": "dimension", "$value": "8px",    "$description": "verified (radius/xl on buttons, inputs, alerts)" },
      "2xl":  { "$type": "dimension", "$value": "12px",   "$description": "assumed" },
      "3xl":  { "$type": "dimension", "$value": "16px",   "$description": "assumed" },
      "4xl":  { "$type": "dimension", "$value": "24px",   "$description": "assumed" },
      "5xl":  { "$type": "dimension", "$value": "32px",   "$description": "assumed" },
      "pill": { "$type": "dimension", "$value": "30px",   "$description": "verified (Status chip uses a hard-coded 30px; should alias to full)" },
      "full": { "$type": "dimension", "$value": "9999px", "$description": "verified (radius/full)" }
    },
    "font": {
      "family": {
        "base":   { "$type": "fontFamily", "$value": ["PingAR+LT", "PingARLT", "PT Sans", "system-ui", "sans-serif"], "$description": "verified (Typography/Family/Font = Ping AR + LT). Single family for Arabic and Latin." }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400, "$description": "verified" },
        "medium":  { "$type": "fontWeight", "$value": 500, "$description": "verified" },
        "bold":    { "$type": "fontWeight", "$value": 700, "$description": "verified" }
      },
      "size": {
        "xs":  { "$type": "dimension", "$value": "12px", "$description": "verified (typography/size/xs)" },
        "sm":  { "$type": "dimension", "$value": "14px", "$description": "verified (typography/size/sm)" },
        "md":  { "$type": "dimension", "$value": "16px", "$description": "verified (typography/size/md, style name $text-base)" },
        "lg":  { "$type": "dimension", "$value": "18px", "$description": "assumed ($text-lg)" },
        "xl":  { "$type": "dimension", "$value": "20px", "$description": "assumed ($text-xl)" },
        "2xl": { "$type": "dimension", "$value": "24px", "$description": "assumed ($text-2xl)" },
        "3xl": { "$type": "dimension", "$value": "30px", "$description": "assumed" },
        "4xl": { "$type": "dimension", "$value": "36px", "$description": "assumed" },
        "5xl": { "$type": "dimension", "$value": "48px", "$description": "assumed" },
        "6xl": { "$type": "dimension", "$value": "60px", "$description": "assumed" },
        "7xl": { "$type": "dimension", "$value": "72px", "$description": "assumed" },
        "8xl": { "$type": "dimension", "$value": "96px", "$description": "assumed" },
        "9xl": { "$type": "dimension", "$value": "128px", "$description": "assumed" }
      },
      "lineHeight": {
        "4": { "$type": "dimension", "$value": "16px", "$description": "verified (line-height/4)" },
        "5": { "$type": "dimension", "$value": "20px", "$description": "verified (line-height/5)" },
        "6": { "$type": "dimension", "$value": "24px", "$description": "verified (line-height/6)" },
        "7": { "$type": "dimension", "$value": "28px", "$description": "assumed" },
        "8": { "$type": "dimension", "$value": "32px", "$description": "assumed" },
        "9": { "$type": "dimension", "$value": "36px", "$description": "assumed" },
        "10": { "$type": "dimension", "$value": "40px", "$description": "assumed" }
      }
    },
    "size": {
      "$description": "Component sizing scale used by Button, Checkbox, Toggle, Loader, Avatar.",
      "control": {
        "sm": { "$type": "dimension", "$value": "32px", "$description": "verified (Button --sm-32px)" },
        "md": { "$type": "dimension", "$value": "40px", "$description": "verified (Button --md-40px, input min-height)" },
        "lg": { "$type": "dimension", "$value": "48px", "$description": "verified (Button --lg-48px)" }
      },
      "icon": {
        "sm": { "$type": "dimension", "$value": "16px", "$description": "verified (button and input icons)" },
        "md": { "$type": "dimension", "$value": "18px", "$description": "verified (alert icon)" },
        "lg": { "$type": "dimension", "$value": "20px" },
        "xl": { "$type": "dimension", "$value": "24px" }
      }
    },
    "duration": {
      "short":  { "$type": "duration", "$value": "100ms" },
      "medium": { "$type": "duration", "$value": "200ms" },
      "long":   { "$type": "duration", "$value": "300ms" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.3, 0, 0.8, 0.15] }
    }
  },

  "sys": {
    "$description": "System (semantic) tokens. Meaning attached, theme-able. These are the names components and product code use. Named role/property, mirroring the Figma 03-Colors collection (text / background / border / foreground) so the two stay diff-able.",
    "color": {
      "primary":            { "$type": "color", "$value": "{ref.palette.teal.900}" },
      "on-primary":         { "$type": "color", "$value": "{ref.palette.gray.0}" },
      "primary-container":  { "$type": "color", "$value": "{ref.palette.teal.100}", "$description": "Secondary mint fill used by the primary Button. Material name: primary container." },
      "on-primary-container": { "$type": "color", "$value": "{ref.palette.teal.900}" },
      "surface":            { "$type": "color", "$value": "{ref.palette.gray.0}" },
      "surface-input":      { "$type": "color", "$value": "{ref.palette.gray.0}", "$description": "background/default/input" },
      "outline":            { "$type": "color", "$value": "{ref.palette.gray.100}", "$description": "border/default" },
      "outline-primary":    { "$type": "color", "$value": "{ref.palette.teal.100}", "$description": "border/secondary (outlined primary button)" },
      "text": {
        "primary":   { "$type": "color", "$value": "{ref.palette.gray.800}", "$description": "text/gray/dark. Note: Figma also names the brand teal 'text/primary/primary'; see naming-conventions.md" },
        "secondary": { "$type": "color", "$value": "{ref.palette.gray.600}", "$description": "text/gray/light. Placeholders, helper text" },
        "brand":     { "$type": "color", "$value": "{ref.palette.teal.900}", "$description": "text/primary/primary and text/primary/link" },
        "inverse":   { "$type": "color", "$value": "{ref.palette.gray.0}",  "$description": "text/gray/white" }
      },
      "status": {
        "success": {
          "primary": { "$type": "color", "$value": "{ref.palette.green.500}" },
          "dark":    { "$type": "color", "$value": "{ref.palette.green.600}" },
          "darker":  { "$type": "color", "$value": "{ref.palette.green.800}" }
        },
        "danger": {
          "lighter": { "$type": "color", "$value": "{ref.palette.red.50}" },
          "primary": { "$type": "color", "$value": "{ref.palette.red.500}" },
          "dark":    { "$type": "color", "$value": "{ref.palette.red.600}" },
          "darker":  { "$type": "color", "$value": "{ref.palette.red.800}" }
        },
        "warning": {
          "primary": { "$type": "color", "$value": "{ref.palette.amber.500}" }
        },
        "info": {
          "lighter": { "$type": "color", "$value": "{ref.palette.blue.50}" },
          "light":   { "$type": "color", "$value": "{ref.palette.blue.100}" },
          "primary": { "$type": "color", "$value": "{ref.palette.blue.500}" },
          "darker":  { "$type": "color", "$value": "{ref.palette.blue.800}" }
        }
      },
      "feature": {
        "$description": "Non-semantic 'feature' accent (upsell / premium). Gradient orange 200 -> 300, text orange 800.",
        "gradient-start": { "$type": "color", "$value": "{ref.palette.orange.200}" },
        "gradient-end":   { "$type": "color", "$value": "{ref.palette.orange.300}" },
        "on-feature":     { "$type": "color", "$value": "{ref.palette.orange.800}" }
      }
    },
    "space": {
      "$description": "Semantic spacing aliases. Old Figma name -> alias mapping is in docs/02-styles/spacing.md",
      "3xs": { "$type": "dimension", "$value": "{ref.space.1}" },
      "2xs": { "$type": "dimension", "$value": "{ref.space.2}" },
      "xs":  { "$type": "dimension", "$value": "{ref.space.3}" },
      "sm":  { "$type": "dimension", "$value": "{ref.space.4}" },
      "md":  { "$type": "dimension", "$value": "{ref.space.5}" },
      "lg":  { "$type": "dimension", "$value": "{ref.space.6}" },
      "xl":  { "$type": "dimension", "$value": "{ref.space.7}" },
      "2xl": { "$type": "dimension", "$value": "{ref.space.8}" },
      "3xl": { "$type": "dimension", "$value": "{ref.space.9}" },
      "4xl": { "$type": "dimension", "$value": "{ref.space.10}" }
    },
    "shape": {
      "$description": "Material 'shape' scale, aliasing ref.radius.",
      "none":        { "$type": "dimension", "$value": "{ref.radius.none}" },
      "extra-small": { "$type": "dimension", "$value": "{ref.radius.md}",  "$description": "checkbox, chips inside inputs" },
      "small":       { "$type": "dimension", "$value": "{ref.radius.xl}",  "$description": "buttons, inputs, alerts, cards - the Salla default" },
      "medium":      { "$type": "dimension", "$value": "{ref.radius.2xl}", "$description": "panels, sheets" },
      "large":       { "$type": "dimension", "$value": "{ref.radius.3xl}", "$description": "modals, bottom sheets" },
      "full":        { "$type": "dimension", "$value": "{ref.radius.full}", "$description": "status chips, avatars, toggles" }
    },
    "typography": {
      "$description": "Type roles (Material: display / headline / title / body / label). Each maps to an existing Figma text style Weight/$text-size.",
      "display-lg":  { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.5xl}", "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "1" },        "$description": "Bold/$text-5xl" },
      "headline-lg": { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.2xl}", "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "{ref.font.lineHeight.8}" }, "$description": "Bold/$text-2xl" },
      "headline-md": { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xl}",  "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "{ref.font.lineHeight.7}" }, "$description": "Bold/$text-xl" },
      "title-lg":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.lg}",  "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "{ref.font.lineHeight.7}" }, "$description": "Bold/$text-lg" },
      "title-md":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.md}",  "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "{ref.font.lineHeight.6}" }, "$description": "Bold/$text-base. verified on Alertbox title" },
      "title-sm":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}",  "fontWeight": "{ref.font.weight.bold}",    "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Bold/$text-sm" },
      "body-md":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.md}",  "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.6}" }, "$description": "Regular/$text-base" },
      "body-sm":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}",  "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Regular/$text-sm. verified on inputs and alert body" },
      "body-xs":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xs}",  "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.4}" }, "$description": "Regular/$text-xs. verified on input subtext" },
      "label-md":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}",  "fontWeight": "{ref.font.weight.medium}",  "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Medium/$text-sm. verified on Button label" },
      "label-sm":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xs}",  "fontWeight": "{ref.font.weight.medium}",  "lineHeight": "{ref.font.lineHeight.4}" }, "$description": "Medium/$text-xs. verified on Status label" }
    },
    "elevation": {
      "$description": "Material elevation levels 0-3. Figma has no shadow styles yet; these are proposed and must be added to the library.",
      "0": { "$type": "shadow", "$value": "none" },
      "1": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px", "color": "#0000000f" } },
      "2": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px", "color": "#00000014" } },
      "3": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px", "color": "#0000001f" } }
    },
    "focus": {
      "ring-width": { "$type": "dimension", "$value": "2px" },
      "ring-color": { "$type": "color", "$value": "{ref.palette.teal.100}" }
    }
  },

  "comp": {
    "$description": "Component tokens. Only where a component needs a value that is not simply a system token. Verified from Figma.",
    "button": {
      "height-sm": { "$type": "dimension", "$value": "{ref.size.control.sm}" },
      "height-md": { "$type": "dimension", "$value": "{ref.size.control.md}" },
      "height-lg": { "$type": "dimension", "$value": "{ref.size.control.lg}" },
      "padding-x": { "$type": "dimension", "$value": "{sys.space.sm}" },
      "padding-y": { "$type": "dimension", "$value": "{sys.space.xs}" },
      "gap":       { "$type": "dimension", "$value": "{sys.space.2xs}" },
      "border-width": { "$type": "dimension", "$value": "2px", "$description": "filled appearances use a 2px border of the same color; outlined uses 1px" },
      "shape":     { "$type": "dimension", "$value": "{sys.shape.small}" },
      "icon-size": { "$type": "dimension", "$value": "{ref.size.icon.sm}" }
    },
    "text-field": {
      "min-height": { "$type": "dimension", "$value": "{ref.size.control.md}" },
      "padding-x":  { "$type": "dimension", "$value": "{sys.space.sm}" },
      "padding-y":  { "$type": "dimension", "$value": "{sys.space.xs}" },
      "gap":        { "$type": "dimension", "$value": "{sys.space.xs}" },
      "shape":      { "$type": "dimension", "$value": "{sys.shape.small}" },
      "label-gap":  { "$type": "dimension", "$value": "{sys.space.sm}" }
    },
    "checkbox": {
      "size-sm": { "$type": "dimension", "$value": "16px" },
      "size-md": { "$type": "dimension", "$value": "20px" },
      "shape":   { "$type": "dimension", "$value": "{sys.shape.extra-small}" }
    },
    "toggle": {
      "size-sm":      { "$type": "dimension", "$value": "16px" },
      "size-default": { "$type": "dimension", "$value": "24px" },
      "track-width-default": { "$type": "dimension", "$value": "39px" }
    },
    "status": {
      "height":    { "$type": "dimension", "$value": "24px" },
      "dot-size":  { "$type": "dimension", "$value": "10px" },
      "padding-x": { "$type": "dimension", "$value": "{sys.space.xs}" },
      "shape":     { "$type": "dimension", "$value": "{sys.shape.full}" }
    },
    "alert": {
      "padding-x":   { "$type": "dimension", "$value": "{sys.space.xl}" },
      "padding-y":   { "$type": "dimension", "$value": "{sys.space.md}" },
      "accent-width": { "$type": "dimension", "$value": "3px", "$description": "inline-start accent border" },
      "icon-size":   { "$type": "dimension", "$value": "{ref.size.icon.md}" },
      "shape":       { "$type": "dimension", "$value": "{sys.shape.small}" }
    },
    "loader": {
      "$description": "_LoadingIndicator sizes, verified from Figma variant names",
      "xxxxs": { "$type": "dimension", "$value": "8px" },
      "xxxs":  { "$type": "dimension", "$value": "16px" },
      "xxs":   { "$type": "dimension", "$value": "20px" },
      "xs":    { "$type": "dimension", "$value": "24px" },
      "sm":    { "$type": "dimension", "$value": "32px" },
      "md":    { "$type": "dimension", "$value": "48px" },
      "lg":    { "$type": "dimension", "$value": "56px" },
      "xl":    { "$type": "dimension", "$value": "64px" },
      "xxl":   { "$type": "dimension", "$value": "88px" }
    }
  }
}
