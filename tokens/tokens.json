      "4xl":  { "$type": "dimension", "$value": "24px",   "$description": "Radius/Sizes/4xl (value not observed)" },
      "5xl":  { "$type": "dimension", "$value": "32px",   "$description": "Radius/Sizes/5xl (value not observed)" },
      "full": { "$type": "dimension", "$value": "9999px", "$description": "radius/full, Radius/Sizes/Full" }
    },
    "font": {
      "family": {
        "base": { "$type": "fontFamily", "$value": ["Ping AR + LT", "PingAR+LT", "PingARLT", "PT Sans", "system-ui", "sans-serif"], "$description": "Typography/Family/Font. One family for Arabic and Latin" }
      },
      "weight": {
        "regular": { "$type": "fontWeight", "$value": 400, "$description": "Typography/Weight/Regular" },
        "medium":  { "$type": "fontWeight", "$value": 500, "$description": "Typography/Weight/Medium" },
        "bold":    { "$type": "fontWeight", "$value": 700, "$description": "Typography/Weight/Bold" }
