      "$description": "Type roles (Material) mapped to the Figma text styles Weight/$text-size.",
      "display-lg":  { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.5xl}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "1" }, "$description": "Bold/$text-5xl" },
      "headline-lg": { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.2xl}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "{ref.font.lineHeight.8}" }, "$description": "Bold/$text-2xl - PageTitle desktop" },
      "headline-md": { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xl}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "{ref.font.lineHeight.7}" }, "$description": "Bold/$text-xl - LearnMore title" },
      "title-lg":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.lg}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "{ref.font.lineHeight.7}" }, "$description": "Bold/$text-lg" },
      "title-md":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.md}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "{ref.font.lineHeight.6}" }, "$description": "Bold/$text-base - Alert title, PageTitle mobile, active Tab" },
      "title-sm":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}", "fontWeight": "{ref.font.weight.bold}", "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Bold/$text-sm - pagination numbers" },
      "body-lg":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.md}", "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.6}" }, "$description": "Regular/$text-base - NavigationItem" },
      "body-md":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}", "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Regular/$text-sm - default UI text: fields, menu items, alert body, table cells" },
      "body-sm":     { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xs}", "fontWeight": "{ref.font.weight.regular}", "lineHeight": "{ref.font.lineHeight.4}" }, "$description": "Regular/$text-xs - helper text, subtext, Table/Status, Tooltip" },
      "label-lg":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.md}", "fontWeight": "{ref.font.weight.medium}", "lineHeight": "{ref.font.lineHeight.6}" }, "$description": "Medium/$text-base - Tabs, active NavigationItem" },
      "label-md":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.sm}", "fontWeight": "{ref.font.weight.medium}", "lineHeight": "{ref.font.lineHeight.5}" }, "$description": "Medium/$text-sm - Button md/lg label, FieldLabel, CheckboxField title" },
      "label-sm":    { "$type": "typography", "$value": { "fontFamily": "{ref.font.family.base}", "fontSize": "{ref.font.size.xs}", "fontWeight": "{ref.font.weight.medium}", "lineHeight": "{ref.font.lineHeight.4}" }, "$description": "Medium/$text-xs - Button sm label, Status label" }
    },
    "elevation": {
      "$description": "Material levels mapped to the Figma Shadows/* styles.",
      "0": { "$type": "shadow", "$value": "none" },
      "1": { "$type": "shadow", "$value": "{ref.shadow.sm}", "$description": "raised Panel (proposed)" },
      "2": { "$type": "shadow", "$value": "{ref.shadow.md}", "$description": "Shadows/md - sticky footer" },
      "3": { "$type": "shadow", "$value": "{ref.shadow.lg}", "$description": "Shadows/lg - MoreMenu, DropdownList, Tooltip" },
      "4": { "$type": "shadow", "$value": "{ref.shadow.xl}", "$description": "Dialog, BottomSheet (proposed)" }
    }
  },

  "comp": {
    "$description": "Component tokens, verified from Figma.",
    "button": {
      "height-sm": { "$type": "dimension", "$value": "{ref.size.control.sm}" },
      "height-md": { "$type": "dimension", "$value": "{ref.size.control.md}" },
      "height-lg": { "$type": "dimension", "$value": "{ref.size.control.lg}" },
      "padding-x-md": { "$type": "dimension", "$value": "{ref.space.lg}" },
      "padding-y-md": { "$type": "dimension", "$value": "{ref.space.sm}" },
      "padding-x-sm": { "$type": "dimension", "$value": "{ref.space.sm}" },
      "padding-y-sm": { "$type": "dimension", "$value": "{ref.space.2xs}" },
      "gap":       { "$type": "dimension", "$value": "{ref.space.2xs}" },
      "border-width-filled":   { "$type": "dimension", "$value": "2px" },
      "border-width-outlined": { "$type": "dimension", "$value": "1px" },
      "shape":     { "$type": "dimension", "$value": "{sys.shape.small}" },
      "icon-size": { "$type": "dimension", "$value": "{ref.size.icon.sm}" }
    },
    "text-field": {
      "min-height": { "$type": "dimension", "$value": "{ref.size.control.md}" },
      "padding-x":  { "$type": "dimension", "$value": "{ref.space.lg}" },
      "padding-y":  { "$type": "dimension", "$value": "{ref.space.sm}" },
      "gap":        { "$type": "dimension", "$value": "{ref.space.sm}" },
      "shape":      { "$type": "dimension", "$value": "{sys.shape.small}" },
      "label-gap":  { "$type": "dimension", "$value": "{ref.space.lg}" },
      "focus-underline": { "$type": "dimension", "$value": "2px", "$description": "colour sys.color.focus-ring (#5196f3), error uses danger.primary" }
    },
    "checkbox": {
      "size-sm": { "$type": "dimension", "$value": "16px" },
      "size-md": { "$type": "dimension", "$value": "20px" },
      "padding": { "$type": "dimension", "$value": "{ref.space.3xs}" },
      "shape":   { "$type": "dimension", "$value": "{sys.shape.extra-small}" }
    },
    "toggle": {
      "size-sm":      { "$type": "dimension", "$value": "16px" },
      "size-default": { "$type": "dimension", "$value": "24px" },
      "track-width-default": { "$type": "dimension", "$value": "39px" }
    },
    "status": {
      "height":    { "$type": "dimension", "$value": "24px" },
      "dot-size":  { "$type": "dimension", "$value": "10px" },
      "gap":       { "$type": "dimension", "$value": "{ref.space.2xs}" },
      "padding-x": { "$type": "dimension", "$value": "{ref.space.sm}" },
      "shape":     { "$type": "dimension", "$value": "{sys.shape.full}" }
    },
    "alert": {
      "padding-x":    { "$type": "dimension", "$value": "{ref.space.4xl}" },
      "padding-y":    { "$type": "dimension", "$value": "{ref.space.2xl}" },
      "gap":          { "$type": "dimension", "$value": "{ref.space.sm}" },
      "accent-width": { "$type": "dimension", "$value": "3px" },
      "icon-size":    { "$type": "dimension", "$value": "{ref.size.icon.md}" },
      "shape":        { "$type": "dimension", "$value": "{sys.shape.small}" }
    },
    "tab": {
      "indicator-width": { "$type": "dimension", "$value": "2px" },
      "padding-y": { "$type": "dimension", "$value": "{ref.space.sm}" },
      "padding-x-primary": { "$type": "dimension", "$value": "{ref.space.2xl}" },
      "shape-primary": { "$type": "dimension", "$value": "{sys.shape.extra-small}" }
    },
    "top-app-bar": {
      "padding-x": { "$type": "dimension", "$value": "{ref.space.9xl}" },
      "padding-y": { "$type": "dimension", "$value": "{ref.space.2xl}" },
      "gap":       { "$type": "dimension", "$value": "{ref.space.3xl}" },
      "logo-height": { "$type": "dimension", "$value": "40px" },
      "avatar-size": { "$type": "dimension", "$value": "{ref.size.control.lg}" }
    },
    "navigation-drawer": {
      "width":      { "$type": "dimension", "$value": "225px" },
      "item-height": { "$type": "dimension", "$value": "{ref.size.control.row}" },
      "item-padding": { "$type": "dimension", "$value": "{ref.space.2xl}" }
    },
    "menu": {
      "width":        { "$type": "dimension", "$value": "240px" },
      "item-padding": { "$type": "dimension", "$value": "{ref.space.lg}" },
      "icon-size":    { "$type": "dimension", "$value": "{ref.size.icon.lg}" },
      "elevation":    { "$type": "shadow", "$value": "{sys.elevation.3}" }
    },
    "tooltip": {
      "padding":   { "$type": "dimension", "$value": "{ref.space.lg}" },
      "shape":     { "$type": "dimension", "$value": "{sys.shape.extra-small}" },
      "caret":     { "$type": "dimension", "$value": "16px x 8px" },
      "elevation": { "$type": "shadow", "$value": "{sys.elevation.3}" }
    },
    "loader": {
      "xxxxs": { "$type": "dimension", "$value": "8px" },
      "xxxs":  { "$type": "dimension", "$value": "16px" },
      "xxs":   { "$type": "dimension", "$value": "20px" },
      "xs":    { "$type": "dimension", "$value": "24px" },
      "sm":    { "$type": "dimension", "$value": "32px" },
      "md":    { "$type": "dimension", "$value": "48px" },
      "lg":    { "$type": "dimension", "$value": "56px" },
      "xl":    { "$type": "dimension", "$value": "64px" },
      "xxl":   { "$type": "dimension", "$value": "88px" }
    }
  }
}
