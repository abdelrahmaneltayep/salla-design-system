    "radius": {
      "$description": "Figma Radius/Sizes collection. Only md, xl, 3xl and full were observed; the others follow the same Tailwind-style scale the observed values sit on.",
      "none": { "$type": "dimension", "$value": "0px",    "$description": "Radius/Sizes/None" },
      "sm":   { "$type": "dimension", "$value": "2px",    "$description": "Radius/Sizes/sm (value not observed). Note: the old variable radius/sm resolves to 8px and must be re-pointed" },
      "md":   { "$type": "dimension", "$value": "4px",    "$description": "radius/md (Checkbox, Tab, Tooltip)" },
